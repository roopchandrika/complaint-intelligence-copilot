# Copy this file to .env and keep .env out of git (.gitignore already lists it).
# SQL Server passwords need 8+ characters with 3 of: uppercase, lowercase, digit, symbol.
# Avoid $ in passwords (Docker Compose treats it as a variable).
MSSQL_SA_PASSWORD=Str0ng!Passw0rd
LEGACY_RO_PASSWORD=R3ad0nly!Copilot
MSSQL_PORT=1433
# Optional: force a driver name if auto-detection picks the wrong one
# MSSQL_DRIVER=ODBC Driver 18 for SQL Server
